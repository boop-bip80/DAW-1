<?xml version="1.0" encoding="utf-8"?>
<!--
  LiVi Wave MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build liviwave.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.scraft` sessions owned by
  LiVi Wave, and LiVi Wave offered under "Open with" for WAV/AIFF/FLAC/MP3 and MIDI files
  (without taking over the user's default player for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="LiVi Wave"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="EE53D3E5-D0AE-40F9-808D-9417FDEBF61A"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="LiVi Wave digital audio workstation" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of LiVi Wave is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LiviWaveIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LiviWaveIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/liviwave" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/liviwave" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="LiVi Wave" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="LiVi Wave" Level="1">
      <ComponentGroupRef Id="LiviWaveFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="LiviWaveFiles" Directory="INSTALLFOLDER">
      <Component Id="LiviWaveNotice">
        <File Id="LiviWaveNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="LiviWaveApp" Guid="091136D7-205E-41A8-9D27-5E231F7CBBD4">
        <File Id="LiviWaveExe" Source="$(var.BinDir)\liviwave.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="LiVi Wave"
              Description="LiVi Wave digital audio workstation" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LiviWaveIcon.ico" IconIndex="0" />
        </File>

        <!-- .scraft: LiVi Wave's own session format; LiVi Wave is its default app. -->
        <ProgId Id="LiViWave.Session" Description="LiVi Wave Session" Icon="LiviWaveExe" IconIndex="0">
          <Extension Id="scraft" ContentType="application/x-liviwave-session">
            <Verb Id="open" Command="Open" TargetFile="LiviWaveExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Audio and MIDI files: offered under "Open with" (imported into a session), never forced
             as the default. -->
        <ProgId Id="LiViWave.Audio" Description="Audio File" Icon="LiviWaveExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LiViWave.Audio\shell\open\command" Value="&quot;[#LiviWaveExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="LiViWave.Midi" Description="MIDI File" Icon="LiviWaveExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LiViWave.Midi\shell\open\command" Value="&quot;[#LiviWaveExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.wav\OpenWithProgids" Name="LiViWave.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aif\OpenWithProgids" Name="LiViWave.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aiff\OpenWithProgids" Name="LiViWave.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.flac\OpenWithProgids" Name="LiViWave.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mp3\OpenWithProgids" Name="LiViWave.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mid\OpenWithProgids" Name="LiViWave.Midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.midi\OpenWithProgids" Name="LiViWave.Midi" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "liviwave"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe" Name="FriendlyAppName" Value="LiVi Wave" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\shell\open\command" Value="&quot;[#LiviWaveExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\SupportedTypes" Name=".scraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\SupportedTypes" Name=".mid" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\liviwave.exe\SupportedTypes" Name=".midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\liviwave.exe" Value="[#LiviWaveExe]" Type="string" />
      </Component>

      <Component Id="LiviWaveCli" Guid="4552049A-C2F0-4AB0-BAE6-A62C3348F4B4">
        <File Id="LiviWaveCliExe" Source="$(var.BinDir)\liviwave-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
